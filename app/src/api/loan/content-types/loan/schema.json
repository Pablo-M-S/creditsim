{
  "kind": "collectionType",
  "collectionName": "loans",
  "info": {
    "singularName": "loan",
    "pluralName": "loans",
    "displayName": "Loan"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "principal": {
      "type": "decimal",
      "required": true
    },
    "interestRates": {
      "type": "decimal",
      "required": true
    },
    "termMonths": {
      "type": "integer",
      "required": true
    },
    "amortizationSystem": {
      "type": "enumeration",
      "enum": [
        "PRICE",
        "SAC"
      ]
    },
    "iofAmount": {
      "type": "decimal"
    },
    "loanStatus": {
      "type": "enumeration",
      "default": "simulated",
      "enum": [
        "simulated",
        "approved",
        "rejected"
      ]
    },
    "customer": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::customer.customer"
    }
  }
}
